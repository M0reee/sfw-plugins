#!/bin/sh
# Ontology 桥接启动器（由 scripts/build_sfw_plugin.py 生成，别手改）。
# 引擎按 .mcp.json 用 /bin/sh 跑它：按这台 Mac 的芯片选桥接，配置用插件根目录的 ontology-bridge.json。
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
conf="$here/../ontology-bridge.json"

if [ "$(uname -s)" != Darwin ]; then
  printf '%s\n' 'Ontology：这个插件只支持 Mac。' >&2
  exit 78
fi
case "$(uname -m)" in
  arm64) arch=arm64 ;;
  x86_64) arch=amd64 ;;
  *) printf '%s\n' "Ontology：不认识这台 Mac 的芯片（$(uname -m)）。" >&2; exit 78 ;;
esac

bin="$here/ontology-bridge-darwin-$arch"
if [ ! -f "$bin" ]; then
  printf '%s\n' 'Ontology：插件里缺桥接程序，请在 SFW 里重新安装 Ontology 插件。' >&2
  exit 66
fi
if [ ! -x "$bin" ]; then
  chmod u+x "$bin" 2>/dev/null || true
fi
if [ ! -x "$bin" ]; then
  # 安装时丢了执行权限、目录又不让改：复制一份到本用户的临时目录再跑
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/ontology-bridge.XXXXXX")
  cp "$bin" "$tmp/ontology-bridge"
  chmod 700 "$tmp/ontology-bridge"
  bin="$tmp/ontology-bridge"
fi
exec "$bin" --config "$conf"
